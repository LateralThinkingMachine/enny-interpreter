{
  "name": "@meeting/call-pilot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "python3 ../../tools/build_web_ui.py operator && tsc --noEmit && vite build",
